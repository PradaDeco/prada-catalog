# Payload
PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=mongodb://127.0.0.1/prada-catalog

# Public server URL
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Admin user seeded by `payload seed` / the seed endpoint
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Cloudflare R2 media storage (S3-compatible)
# If R2_BUCKET is unset, media falls back to local disk (public/media)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
